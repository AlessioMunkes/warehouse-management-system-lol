# A long random string used to sign JWT tokens.
JWT_SECRET=your_jwt_secret_here

# The web address of this app. Every link the server puts in an email or a
# redirect starts with it: invites, password resets, the Section 18A donor
# form, the Finance report, the Gmail sign-in return and saved report emails.
# Local dev: http://localhost:5173 (used when nothing is set outside production)
# Production: https://your-actual-domain.com (no trailing slash). With nothing
# set in production the server still starts, but it logs an error and does not
# send emails that would carry a broken link. Settings > Connections shows each
# kind of link and where its address came from.
APP_BASE_URL=http://localhost:5173

# The URL your React frontend runs on (used for CORS).
# Older setups set this, CLIENT_URL or FRONTEND_URL instead of APP_BASE_URL and
# links keep using them. Set APP_BASE_URL and these only matter for CORS.
# Per-link overrides, only if one kind of link must point elsewhere:
#   USER_INVITE_BASE_URL, PASSWORD_RESET_BASE_URL, SECTION18A_FORM_BASE_URL
CLIENT_ORIGIN=http://localhost:5173

# Port the server listens on (optional, defaults to 5000)
PORT=5000

# PostgreSQL connection details
DB_USER=your_database_user
DB_HOST=your_database_host
DB_NAME=your_database_name
DB_PASSWORD=your_database_password
DB_PORT=5432

# ── Supabase Postgres connection ────────────────────────────────
DATABASE_URL= uri-here

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Models tried in order when the one above is out of quota (429),
# overloaded (503), retired (404) or times out. Free-tier limits are
# per model, so the next one is usually free. Empty = no fallback.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest

# Timeout per model attempt, in milliseconds. Default 12000. If every
# model fails, the reporting ask box falls back to keyword matching.
GEMINI_TIMEOUT_MS=12000

# ── Multi-warehouse mode (optional) ─────────────────────────────
# Leave unset to run one warehouse on DATABASE_URL (today's setup).
# Set it to run several warehouses, each on its own database. JSON
# object keyed by warehouse code (lowercase letters, digits, hyphens).
# When set, DATABASE_URL is ignored. Every database must be different.
# WAREHOUSE_DB_URLS={"cpt":"postgres://...","gauteng":"postgres://...","northern-cape":"postgres://..."}
#
# Optional display names for the warehouse switcher. A warehouse with
# no name shows its code.
# WAREHOUSE_NAMES={"cpt":"Cape Town","gauteng":"Gauteng","northern-cape":"Northern Cape"}
#
# New warehouse database:  npm run migrate -- init <code>
# Schema changes, all sites: npm run migrate -- up

# ── Push notifications (optional) ───────────────────────────────
# Lets warehouse workers get a phone notification when new picking
# slips land on the floor. Generate a pair once per deployment with
#   npx web-push generate-vapid-keys
# and keep the same pair: changing it silently breaks every phone
# that already turned alerts on (they have to turn them on again).
# Leave unset to switch phone notifications off; the in-app bell
# still works. VAPID_SUBJECT is a contact address push services can
# use if something goes wrong.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org

# External Volunteer Management System integration (optional)
VMS_ADAPTER=mock
VMS_API_TOKEN=
VMS_BASE_URL=
