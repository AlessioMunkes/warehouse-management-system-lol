# ─────────────────────────────────────────────────────────────
# server/env.example — every setting the server reads from its environment
#
# Local development: copy this file to server/.env and fill it in.
# Production (Render): the same names go in the Render dashboard, under
# the Batches service > Environment. Never commit a filled-in .env.
#
# Where the real values live: the organisation's password manager
# (the shared "Batches" collection in Bitwarden). Each entry there says
# which account the key belongs to and what stops working if it changes.
# Business values (cut-off hours, rounding, bands, unit weights, wording)
# are NOT here: an admin changes those in the app, under Settings.
#
# Check a setup without showing any values:
#   cd server && npm run check-env
#
# Sections, in order:
#   1. Required        the server will not work without these
#   2. Production      set these on the live server
#   3. Optional        each one switches on a feature; unset = feature off
#   4. Tuning          sensible defaults; change only with a reason
#   5. Set by the platform, and used by scripts only
# ─────────────────────────────────────────────────────────────


# ══ 1. REQUIRED ══════════════════════════════════════════════

# The PostgreSQL database. In Supabase: Connect > Session pooler.
# postgresql://USER:PASSWORD@HOST:5432/postgres
# Use a separate TEST database on your own laptop, never production.
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Signs everyone's login. A long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it signs everyone out. Render generates one (render.yaml).
JWT_SECRET=replace-with-a-long-random-string


# ══ 2. PRODUCTION ════════════════════════════════════════════

# The web address people open the app on, with no trailing slash. Every
# link the server puts in an email starts with it (invites, password
# resets, the Section 18A donor form, the Finance report, saved reports).
# Local: http://localhost:5173 (used when nothing is set outside production).
# Settings > Connections shows each kind of link and where it came from.
APP_BASE_URL=http://localhost:5173

# production on the live server: serves the built app, secure cookies,
# no localhost origins. Leave unset locally. Render sets it (render.yaml).
# NODE_ENV=production

# The header holding the visitor's real address. Render puts Cloudflare
# in front, so on Render this is cf-connecting-ip (render.yaml sets it).
# Without it every rate limiter (login, slip codes, password reset)
# counts the whole internet as a few visitors. Leave unset locally.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# Database SSL. On by default, unchecked. For a local Postgres without
# SSL use false. To check Supabase's certificate, give its CA (Project
# Settings > Database > SSL Configuration) as a file path or PEM text.
# DB_SSL=false
# DB_SSL_CA=./supabase-ca.crt
# Or, for a provider whose certificate is publicly signed:
# DB_SSL=verify


# ══ 3. OPTIONAL FEATURES ═════════════════════════════════════

# ── Email: the organisation's Gmail sending account ──────────
# Off until all four are set and an admin connects the account under
# Settings > Connections. GMAIL_TOKEN_ENCRYPTION_KEY is base64 for 32
# random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the same key: changing it means connecting Gmail again.
# Before go-live: in Google Cloud, OAuth consent screen > Publish app
# (from "Testing" to "In production"), or Google stops the connection
# after 7 days. Set the redirect to the live address there too.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=
# false records emails in Message history without sending them.
# EMAIL_ENABLED=true
# Emails are sent FROM the Gmail account connected under Settings >
# Email, with the sender name set there too. EMAIL_FROM is only a
# fallback label when no account is connected; it does not change what
# recipients see.
# EMAIL_FROM=noreply@ladlesoflove.org
# EMAIL_LOGO_URL=https://your-actual-domain.com/images/pdf_logo.png

# ── AI: the help assistant and the reporting question box ────
# Both are off (quietly) without a key. Google AI Studio > Get API key.
GEMINI_API_KEY=

# ── QuickBooks ───────────────────────────────────────────────
# Off unless ID, secret and redirect are all set. Finance then connects
# their company under Settings > Connections.
# Before go-live: set QUICKBOOKS_ENVIRONMENT=production and use the
# production keys from the Intuit developer app (not the sandbox ones).
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_REDIRECT_URI=http://localhost:5000/api/quickbooks/callback
# QUICKBOOKS_ENVIRONMENT=sandbox
# Falls back to GMAIL_TOKEN_ENCRYPTION_KEY when unset.
# QUICKBOOKS_TOKEN_ENCRYPTION_KEY=

# ── Phone notifications for warehouse workers ────────────────
# Generate ONE pair per deployment and keep it:
#   npx web-push generate-vapid-keys
# Changing the pair silently stops every phone that turned alerts on.
# Unset: no phone notifications; the bell in the app still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@ladlesoflove.org

# ── Volunteer Management System ──────────────────────────────
# mock keeps volunteers inside this app. Set the real adapter, token
# and address when the external system is ready.
VMS_ADAPTER=mock
VMS_API_TOKEN=
VMS_BASE_URL=

# ── More than one warehouse ──────────────────────────────────
# Unset: one warehouse on DATABASE_URL. Set: JSON keyed by warehouse
# code (lowercase letters, digits, hyphens), each on its own database,
# and DATABASE_URL is ignored.
# WAREHOUSE_DB_URLS={"cpt":"postgresql://...","gauteng":"postgresql://..."}
# WAREHOUSE_NAMES={"cpt":"Cape Town","gauteng":"Gauteng"}
# A new warehouse database:  npm run migrate -- init <code>

# ── The guest gate code ──────────────────────────────────────
# The key for the day's guest gate code. Unset, one is derived from
# JWT_SECRET. Changing it changes today's code at once.
# GATE_CODE_SECRET=another-long-random-string


# ══ 4. TUNING (defaults are fine) ════════════════════════════

# Port the server listens on. Default 5000.
# PORT=5000

# Gemini model, the backups tried when it is busy or out of quota, and
# how long to wait for each (ms). Matches render.yaml.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
# GEMINI_TIMEOUT_MS=12000

# Database connections each server keeps (Supabase's session pooler
# allows 15 in all). Use 3 when developing.
# DB_POOL_MAX=5
# DB_POOL_MIN=2

# Gmail permissions. Default: gmail.send openid email profile
# GMAIL_SCOPES=

# Product lookups by barcode (only the barcode is sent). On unless false.
# OPEN_FOOD_FACTS_ENABLED=true

# Scheduled jobs. Set false on a second server sharing the database.
# ECD_REMINDER_SCHEDULER=false
# SAVED_REPORTS_SCHEDULER=false

# One kind of link pointing somewhere other than APP_BASE_URL (rare).
# USER_INVITE_BASE_URL=
# PASSWORD_RESET_BASE_URL=
# SECTION18A_FORM_BASE_URL=

# Older setups used these instead of APP_BASE_URL; links still read them
# when APP_BASE_URL is unset. APP_BASE_URL is also allowed to call the
# API, so a custom domain needs nothing else. CLIENT_ORIGIN adds one
# more allowed origin, if the app is ever opened from a second address.
# CLIENT_ORIGIN=
# CLIENT_URL=
# FRONTEND_URL=


# ══ 5. SET BY THE PLATFORM / SCRIPTS ONLY ════════════════════
# RENDER_EXTERNAL_URL         Render sets this; it is allowed for CORS
# TZ                          leave unset; dates are worked out in SAST
# WMS_BASE_URL                scripts/loadRealData.mjs: the API to load into
# GAP_MS                      scripts/evalReportingQuestions.js: pause between questions
# NOMINATIM_CONTACT           scripts/locateEcdCentres.mjs: contact sent to OpenStreetMap
