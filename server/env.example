# A long random string used to sign JWT tokens.
JWT_SECRET=your_jwt_secret_here

# The URL your React frontend runs on (used for CORS).
# Local dev: http://localhost:5173
# Production: https://your-actual-domain.com
CLIENT_ORIGIN=http://localhost:5173

# Port the server listens on (optional, defaults to 5000)
PORT=5000

# PostgreSQL connection details
DB_USER=your_database_user
DB_HOST=your_database_host
DB_NAME=your_database_name
DB_PASSWORD=your_database_password
DB_PORT=5432

# ── Supabase Postgres connection ────────────────────────────────
DATABASE_URL= uri-here

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Per-attempt timeout for the AI assistant, in milliseconds.
# Default 25000. Raise it if the free tier is consistently slow;
# the request is retried once on a timeout or an overload.
GEMINI_TIMEOUT_MS=25000
