# The URL your backend API runs on.
# Local dev:   http://localhost:5000
# Production:  https://your-api-domain.com
VITE_API_URL=http://localhost:5000

# Public Mapbox token for address autocomplete.
# Use a public, domain-restricted token only. Do not put a secret token here.
VITE_MAPBOX_PUBLIC_TOKEN=pk.your_public_mapbox_token

# Optional: the letterhead on printed delivery and dispatch notes.
# Defaults to the Cape Town warehouse. Separate address lines with |.
# VITE_WAREHOUSE_NAME=Ladles of Love, Cape Town Warehouse
# VITE_WAREHOUSE_ADDRESS=Unit 4, Hewett Park|17 Hewett Ave, Epping|Cape Town, 7460

# Optional: the address printed in pallet QR codes. Normally worked out
# from where the app is opened; set it when that is not the public
# address (for example a manager printing labels from localhost).
# VITE_PUBLIC_APP_ORIGIN=https://your-actual-domain.com
